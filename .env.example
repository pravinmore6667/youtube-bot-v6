# ── Thumbnail Image Generation ─────────────────────────────
HF_TOKEN=              # huggingface.co/settings/tokens
                       # Used for: FLUX thumbnails, Kokoro TTS, MusicGen
IDEOGRAM_API_KEY=      # ideogram.ai — 10 free images/day
                       # Best for thumbnails with text in image

# ── Voice / TTS ─────────────────────────────────────────────
ELEVENLABS_API_KEY=    # elevenlabs.io — 10,000 chars/month free
PLAYHT_API_KEY=        # play.ht — 12,500 words/month free
PLAYHT_USER_ID=        # play.ht dashboard user ID

# ── LLM Providers ───────────────────────────────────────────
CEREBRAS_API_KEY=      # cloud.cerebras.ai — 1M tokens/day free
OPENROUTER_API_KEY=    # openrouter.ai — use free models only
SAMBANOVA_API_KEY=     # cloud.sambanova.ai — free Llama 3.1 405B
# ── Indian Voice (Critical for Indian content) ───────────────
BHASHINI_USER_ID=          # bhashini.gov.in — free, instant signup
BHASHINI_ULCA_API_KEY=     # same dashboard, 22 Indian languages
FISH_AUDIO_API_KEY=        # fish.audio — free 10 min/month, Indian voices

# ── Video Generation (B-Roll quality upgrade) ────────────────
KLING_API_KEY=             # klingai.com — 66 free credits/day

# ── Research & Script Quality ────────────────────────────────
PERPLEXITY_API_KEY=        # perplexity.ai — 5 req/min free tier

# ── LLM (file exists, missing from .env.example) ────────────
NVIDIA_API_KEY=            # build.nvidia.com — 40K tokens/min free

# ── Indian Language Settings ─────────────────────────────────
# CHANNEL_LANGUAGE=en-in      ← for Indian English content
# CHANNEL_LANGUAGE=hi         ← for Hindi content
# TTS_VOICE_GENDER=male        ← or female
